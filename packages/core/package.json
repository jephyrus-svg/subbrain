{
  "name": "@subbrain/core",
  "version": "0.1.0-alpha",
  "private": true,
  "type": "module",
  "bin": {
    "subbrain": "./src/cli.ts"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts start --dev",
    "start": "tsx src/cli.ts start",
    "seed": "tsx src/cli.ts seed --dev",
    "import": "tsx src/cli.ts import --dev",
    "regenerate-vault": "tsx src/cli.ts regenerate-vault --dev",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "mocks": "tsx src/cli.ts mocks"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.69",
    "@ai-sdk/google": "^4.0.86",
    "@ai-sdk/openai": "^4.0.82",
    "@ai-sdk/xai": "^5.0.13",
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@subbrain/shared": "workspace:*",
    "ai": "^7.0.123",
    "fflate": "^0.8.3",
    "hono": "^4.13.11",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=22.16"
  },
  "devDependencies": {
    "@types/node": "22",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^5.0.2"
  }
}
